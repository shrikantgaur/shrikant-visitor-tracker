# Everything below stays in the repository and out of the plugin ZIP.
/.git
/.github
/.gitignore
/.distignore
/.editorconfig

/node_modules
/vendor
/tests
/bin
.DS_Store
*.log
*.zip
README.md
phpcs.xml
phpcs.xml.dist
composer.json
composer.lock
package.json
package-lock.json
/tools

# The directory's banner, icon and screenshots. The deploy action uploads
# these to the assets/ folder in SVN itself; they have no business inside
# the plugin ZIP, where they would be downloaded by every user forever.
/.wordpress-org
